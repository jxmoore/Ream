<UserControl x:Class="Ream.App.Views.WorkspaceTabs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ItemsControl x:Name="Tabs" ItemsSource="{Binding Workspaces}" Focusable="False" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid Margin="2,0" VerticalAlignment="Center">
                    <Border x:Name="Chip" CornerRadius="10" Padding="10,2" Cursor="Hand"
                            Background="Transparent"
                            ToolTip="Click to switch, double-click to rename"
                            MouseLeftButtonDown="OnChipMouseDown">
                        <TextBlock x:Name="Label" Text="{Binding DisplayLabel}" FontSize="12"
                                   MaxWidth="160" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ToolbarMutedBrush}"/>
                    </Border>
                    <TextBox x:Name="NameBox" Visibility="Collapsed" MinWidth="110" MaxLength="40" FontSize="12"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="OnNameKeyDown"
                             LostKeyboardFocus="OnNameLostFocus"
                             IsVisibleChanged="OnNameBoxVisibleChanged"/>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                        <Setter TargetName="Chip" Property="Opacity" Value="0.6"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ChipCurrentBrush}"/>
                        <Setter TargetName="Chip" Property="Opacity" Value="1"/>
                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource ChipCurrentTextBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                        <Setter TargetName="Chip" Property="Visibility" Value="Hidden"/>
                        <Setter TargetName="NameBox" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
