<UserControl x:Class="Ream.App.Views.ViewRibbonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The View tab: how Ream looks. Everything here applies at once and is saved to config.json shortly after. -->
    <StackPanel Orientation="Horizontal" Margin="12,6,12,2">

        <!-- Theme: one dropdown; each entry shows a little swatch of the theme's colors -->
        <StackPanel>
            <StackPanel MinHeight="60" Orientation="Horizontal">
                <ComboBox x:Name="ThemeBox" Width="200" Height="30" VerticalAlignment="Center" Margin="4,0"
                          ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                          Focusable="False" ToolTip="Color theme">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left" Width="40" Height="20" CornerRadius="4" Margin="0,0,10,0"
                                        BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}"
                                        Background="{Binding Canvas}">
                                    <Grid>
                                        <Border Margin="5,4,0,4" Width="18" HorizontalAlignment="Left" CornerRadius="3" Background="{Binding Card}"/>
                                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" HorizontalAlignment="Right" Fill="{Binding Accent}"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Theme"/>
        </StackPanel>

        <Rectangle Style="{StaticResource RibbonGroupDivider}"/>

        <!-- Opacity: two short sliders, stacked -->
        <StackPanel>
            <Grid MinHeight="60" VerticalAlignment="Center" Margin="4,0" Background="{DynamicResource ChromePlateBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Canvas" FontSize="12" VerticalAlignment="Center" Margin="6,0,10,0"
                           Foreground="{DynamicResource ToolbarMutedBrush}"/>
                <Slider x:Name="OpacitySlider" Grid.Row="0" Grid.Column="1" Width="110" VerticalAlignment="Center"
                        Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" Focusable="False"
                        Value="{Binding OpacityPercent, Mode=TwoWay}" ToolTip="{Binding OpacityHint}"/>
                <TextBlock x:Name="CanvasOpacityLabel" Grid.Row="0" Grid.Column="2" Text="{Binding OpacityLabel}" MinWidth="38" Margin="8,0,6,0"
                           TextAlignment="Right" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Notes" FontSize="12" VerticalAlignment="Center" Margin="6,0,10,0"
                           Foreground="{DynamicResource ToolbarMutedBrush}"/>
                <Slider x:Name="NoteOpacitySlider" Grid.Row="1" Grid.Column="1" Width="110" VerticalAlignment="Center"
                        Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" Focusable="False"
                        Value="{Binding NoteOpacityPercent, Mode=TwoWay}"
                        ToolTip="How solid each note's background is. The text always stays solid."/>
                <TextBlock x:Name="NoteOpacityLabel" Grid.Row="1" Grid.Column="2" Text="{Binding NoteOpacityLabel}" MinWidth="38" Margin="8,0,6,0"
                           TextAlignment="Right" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
            </Grid>
            <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Opacity"/>
        </StackPanel>
    </StackPanel>
</UserControl>
