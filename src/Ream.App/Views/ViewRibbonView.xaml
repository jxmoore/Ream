<UserControl x:Class="Ream.App.Views.ViewRibbonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The View tab. Loosely mirrors Word's own View tab groups (Views, Show, Zoom, Window), reworked to what Ream
        actually has: Word's Page Movement group is dropped outright (Ream's row is always horizontal, its workspace
        stack always vertical - no equivalent toggle), and Print Layout / Web Layout go with it (no page to offer a
        page-layout mode for). Word controls Ream has no behaviour for yet are placed anyway, disabled, the same
        convention the Home tab already uses (see its own top-of-file note). Ream's own settings (nothing in Word's
        View tab to mirror) are tacked on at the very end: Layout, Theme, then Opacity.
    -->
    <UserControl.Resources>
        <!-- A small icon+text row: three of these stack beside a group's main tile(s), Word's own rhythm
             (Outline/Draft under Views, One Page/Multiple Pages/Page Width under Zoom, ...). Based on RibbonTile so it
             inherits the same flat (no frame until hovered) behaviour, just resized into a row instead of a tile. -->
        <Style x:Key="StackedRow" TargetType="Button" BasedOn="{StaticResource RibbonTile}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="19"/>
            <Setter Property="Margin" Value="2,0.5"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <!-- Icons drawn as paths take the button's own foreground, so they follow the theme and dim when disabled
             (matches RibbonView's own LineIcon, which isn't shared - this tab needs the same trick independently). -->
        <Style x:Key="ViewLineIcon" TargetType="Path">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ViewDropArrow" TargetType="Path">
            <Setter Property="Data" Value="M0.5,0.5 L3.5,3.5 L6.5,0.5"/>
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" Margin="12,6,12,2">

        <!-- Views: Read Mode, Draft and Outline are all real, in a vertical column as asked. Word's own Print Layout /
             Web Layout are dropped outright - Ream has no page to offer page-layout modes for. -->
        <StackPanel>
            <StackPanel MinHeight="60" VerticalAlignment="Center" Margin="2,0">
                <Button x:Name="ReadModeButton" Style="{StaticResource StackedRow}" Click="OnReadModeClick"
                        ToolTip="A full view of the focused note with no ability to edit it (Alt+F11)">
                    <StackPanel Orientation="Horizontal">
                        <!-- An open book, drawn by hand - no icon-font glyph reads as "book" reliably enough to risk guessing one. -->
                        <Path Style="{StaticResource ViewLineIcon}" Width="16" Height="14"
                              Data="M1,3 L7,2 V13 L1,12 Z M15,3 L9,2 V13 L15,12 Z M8,2.5 V13"/>
                        <TextBlock Text="Read Mode" FontSize="12" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="DraftButton" Style="{StaticResource StackedRow}" Click="OnDraftViewClick"
                        ToolTip="A simplified layout: hides images while you write (nothing is deleted - turn it off to see them again)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE70F;" FontSize="13" Width="18"/>
                        <TextBlock Text="Draft" FontSize="12" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="OutlineButton" Style="{StaticResource StackedRow}" Click="OnOutlineViewClick"
                        ToolTip="Shows just the note's heading structure - click a heading to jump to it">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE8FD;" FontSize="13" Width="18"/>
                        <TextBlock Text="Outline" FontSize="12" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Views"/>
        </StackPanel>

        <Rectangle Style="{StaticResource RibbonGroupDivider}"/>

        <!-- Show: all three real. Ruler acts on the focused note (like Draft/Outline, a Button relayed to a command -
             DataContext here is SettingsViewModel, which has no path to "the focused note's own flag" to bind a
             CheckBox's IsChecked to). Gridlines and Navigation Pane are session-only settings SettingsViewModel owns
             outright, so they're ordinary two-way CheckBoxes. -->
        <StackPanel>
            <StackPanel MinHeight="60" VerticalAlignment="Center" Margin="6,0">
                <Button x:Name="RulerButton" Style="{StaticResource StackedRow}" Click="OnRulerClick"
                        ToolTip="Shows a draggable left-indent marker above the focused note">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ViewLineIcon}" Width="14" Height="14"
                              Data="M1,4 H15 M1,4 V13 H15 V4 M4,4 V7 M7,4 V7 M10,4 V7 M13,4 V7"/>
                        <TextBlock Text="Ruler" FontSize="12" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
                <CheckBox x:Name="GridlinesCheckBox" Content="Gridlines" Margin="0,6,0,2"
                          IsChecked="{Binding GridlinesOn, Mode=TwoWay}"
                          ToolTip="A faint grid behind the notes"/>
                <CheckBox x:Name="NavigationPaneCheckBox" Content="Navigation Pane" Margin="0,2"
                          IsChecked="{Binding NavigationPaneOpen, Mode=TwoWay}"
                          ToolTip="Headings, notes, workspaces and search, docked to the side"/>
            </StackPanel>
            <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Show"/>
        </StackPanel>

        <Rectangle Style="{StaticResource RibbonGroupDivider}"/>

        <!-- Zoom: three stacked buttons, each its own magnifying-glass glyph (Segoe Fluent Icons' own ZoomIn/ZoomOut/Zoom -
             MUI isn't a font available on Windows/WPF, so an icon font already on the system stands in for it), all
             real. Word's page-view trio (One Page, Multiple Pages, Page Width) is dropped: One Page moves to the
             Window group below (a Ream command, not a placeholder), and Ream has no pages for the other two. -->
        <StackPanel>
            <StackPanel MinHeight="60" VerticalAlignment="Center" Margin="2,0">
                <Button x:Name="ZoomInButton" Style="{StaticResource StackedRow}" Click="OnZoomIn" ToolTip="Zoom in (or Ctrl+Scroll up)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE71E;" FontSize="13" Width="18"/>
                        <TextBlock Text="Zoom In" FontSize="12" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ZoomOutButton" Style="{StaticResource StackedRow}" Click="OnZoomOut" ToolTip="Zoom out (or Ctrl+Scroll down)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE71F;" FontSize="13" Width="18"/>
                        <TextBlock Text="Zoom Out" FontSize="12" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ZoomResetButton" Style="{StaticResource StackedRow}" Click="OnZoomReset" ToolTip="{Binding ZoomResetTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE721;" FontSize="13" Width="18"/>
                        <TextBlock Text="Reset" FontSize="12" Margin="4,0,4,0"/>
                        <TextBlock x:Name="ZoomLabel" Text="{Binding ZoomLabel}" FontSize="12" Foreground="{DynamicResource ToolbarMutedBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Zoom"/>
        </StackPanel>

        <Rectangle Style="{StaticResource RibbonGroupDivider}"/>

        <!-- Window: Word's own New Window, Arrange All, Split, View Side by Side and Reset Window Position are all
             dropped outright - Ream has no multi-window concept for any of them (New Note / New Workspace, which
             stood in for New Window / Arrange All, moved to File's own Add group). Synchronous Scrolling and Switch
             Windows (renamed Switch Notes, Ream has notes, not windows) are kept and made real, joined by One Page
             (moved from Zoom): three stacked. -->
        <StackPanel>
            <StackPanel MinHeight="60" VerticalAlignment="Center" Margin="2,0">
                <Button x:Name="OnePageButton" Style="{StaticResource StackedRow}" Click="OnOnePageClick"
                        ToolTip="Shows only the focused note - still navigate freely, but one at a time">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ViewLineIcon}" Width="14" Height="14" Data="M3,1.5 H11 V14.5 H3 Z"/>
                        <TextBlock Text="One Page" FontSize="12" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
                <CheckBox x:Name="SynchronousScrollingCheckBox" Content="Synchronous Scrolling" Margin="2,6,0,2"
                          IsChecked="{Binding SynchronousScrollingOn, Mode=TwoWay}"
                          ToolTip="Scrolling one note scrolls every other loaded note in the row with it"/>
                <Button x:Name="SwitchNotesButton" Style="{StaticResource StackedRow}" Click="OnSwitchNotesClick"
                        ToolTip="Jump to another note in this workspace">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ViewLineIcon}" Width="14" Height="14" Data="M2,2 H10 V10 H2 Z M6,6 H14 V14 H6 Z"/>
                        <TextBlock Text="Switch Notes" FontSize="12" Margin="4,0,4,0"/>
                        <Path Style="{StaticResource ViewDropArrow}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Window"/>
        </StackPanel>

        <Rectangle Style="{StaticResource RibbonGroupDivider}"/>

        <!-- Theme: what used to be three separate groups (Layout, Theme, Opacity) is now a single button that opens
             a modal (ThemeModal) with all three as sections, editing the exact same SettingsViewModel properties
             those groups did - this tile is just a different door to them. -->
        <StackPanel>
            <StackPanel Orientation="Horizontal" MinHeight="60" VerticalAlignment="Center">
                <Button x:Name="ThemeButton" Style="{StaticResource RibbonTile}" Click="OnThemeClick"
                        ToolTip="Layout, theme and opacity">
                    <StackPanel>
                        <!-- A half-filled circle (a plain light/dark "theme" mark) - no icon-font glyph reads as
                             "appearance" reliably enough to risk guessing one. -->
                        <Grid Width="18" Height="18" HorizontalAlignment="Center">
                            <Ellipse Width="18" Height="18" StrokeThickness="1.4"
                                     Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
                            <Path Data="M9,0.7 A7.3,7.3 0 0 1 9,15.3 Z"
                                  Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
                        </Grid>
                        <TextBlock Text="Theme" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Theme"/>
        </StackPanel>
    </StackPanel>
</UserControl>
