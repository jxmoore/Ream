<Window x:Class="Ream.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ream Help" Width="580" Height="680" MinWidth="420" MinHeight="320"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,8">
            <TextBlock Text="Keyboard and mouse" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                       Text="Shortcuts are read from config.json; change one there and it shows here."/>
            <TextBlock x:Name="HintText" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
        </StackPanel>

        <ScrollViewer x:Name="Scroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsControl x:Name="Sections" Margin="24,4,24,12" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,10,0,6">
                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <Border x:Name="Card" Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="12,4"
                                    BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                                <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Description}" TextWrapping="Wrap"
                                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                                <Border Grid.Column="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                                                        Background="{DynamicResource ControlBrush}"
                                                        BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}">
                                                    <TextBlock Text="{Binding Gesture}" FontFamily="Consolas" FontSize="12"
                                                               Foreground="{DynamicResource ControlTextBrush}"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button x:Name="CloseButton" Grid.Row="2" Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right"
                Margin="24,4,24,18" Padding="18,4"/>
    </Grid>
</Window>
