<UserControl x:Class="Ream.App.Views.FileRibbonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The File tab: the ream itself, the workspaces (click one to go there), and Help / About. -->
    <StackPanel Orientation="Horizontal" Margin="12,6,12,2">

        <StackPanel>
            <Button x:Name="OpenButton" Style="{StaticResource RibbonTile}" IsEnabled="False"
                    ToolTipService.ShowOnDisabled="True" ToolTip="Coming soon">
                <StackPanel>
                    <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE838;" FontSize="20"/>
                    <TextBlock Text="Open Ream…" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>
            <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Ream"/>
        </StackPanel>

        <Rectangle Style="{StaticResource RibbonGroupDivider}"/>

        <StackPanel>
            <ItemsControl x:Name="WorkspaceList" ItemsSource="{Binding Workspaces}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="WorkspaceButton" Style="{StaticResource RibbonTile}" VerticalAlignment="Center"
                                Command="{Binding DataContext.SelectWorkspaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" ToolTip="Go to this workspace">
                            <TextBlock Text="{Binding MenuLabel}" FontSize="12" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="WorkspaceButton" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="WorkspaceButton" Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Workspaces"/>
        </StackPanel>

        <Rectangle Style="{StaticResource RibbonGroupDivider}"/>

        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="HelpButton" Style="{StaticResource RibbonTile}" Click="OnHelp" ToolTip="Every shortcut, as bound right now">
                    <StackPanel>
                        <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE897;" FontSize="20"/>
                        <TextBlock Text="Help" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="AboutButton" Style="{StaticResource RibbonTile}" Click="OnAbout" ToolTip="Version and where your notes live">
                    <StackPanel>
                        <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE946;" FontSize="20"/>
                        <TextBlock Text="About" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Help"/>
        </StackPanel>
    </StackPanel>
</UserControl>
