<UserControl x:Class="Ream.App.Views.FileRibbonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The File tab: the ream itself, the workspaces (click one to go there), and Help / About. -->
    <StackPanel Orientation="Horizontal" Margin="12,6,12,2">

        <StackPanel>
            <Button x:Name="OpenButton" Style="{StaticResource RibbonTile}" IsEnabled="False" MinHeight="54"
                    ToolTipService.ShowOnDisabled="True" ToolTip="Coming soon">
                <StackPanel>
                    <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE838;" FontSize="20"/>
                    <TextBlock Text="Open Ream…" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>
            <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Ream"/>
        </StackPanel>

        <Rectangle Style="{StaticResource RibbonGroupDivider}"/>

        <!-- Workspaces: equal-sized tiles, two high, reading top to bottom then left to right. The current one is filled. -->
        <StackPanel>
            <ItemsControl x:Name="WorkspaceList" ItemsSource="{Binding Workspaces}" Focusable="False" MinHeight="60" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Vertical" Height="62"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="WorkspaceButton" Width="158" Height="28" Margin="2,1" Padding="10,0" MinWidth="0"
                                Focusable="False" HorizontalContentAlignment="Left"
                                Command="{Binding DataContext.SelectWorkspaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" ToolTip="Go to this workspace">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Plus" Text="+" Visibility="Collapsed" Margin="0,0,6,0" FontSize="12"/>
                                <TextBlock x:Name="Name" Text="{Binding MenuLabel}" FontSize="12" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsEdge}" Value="True">
                                <Setter TargetName="Plus" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Plus" Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                <Setter TargetName="Name" Property="FontStyle" Value="Italic"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="WorkspaceButton" Property="Background" Value="{DynamicResource ChipCurrentBrush}"/>
                                <Setter TargetName="WorkspaceButton" Property="BorderBrush" Value="{DynamicResource ChipCurrentBrush}"/>
                                <Setter TargetName="Plus" Property="Foreground" Value="{DynamicResource ChipCurrentTextBrush}"/>
                                <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource ChipCurrentTextBrush}"/>
                                <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Workspaces"/>
        </StackPanel>

        <Rectangle Style="{StaticResource RibbonGroupDivider}"/>

        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="HelpButton" Style="{StaticResource RibbonTile}" MinHeight="54" Click="OnHelp" ToolTip="Every shortcut, as bound right now">
                    <StackPanel>
                        <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE897;" FontSize="20"/>
                        <TextBlock Text="Help" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="AboutButton" Style="{StaticResource RibbonTile}" MinHeight="54" Click="OnAbout" ToolTip="Version and where your notes live">
                    <StackPanel>
                        <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE946;" FontSize="20"/>
                        <TextBlock Text="About" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Help"/>
        </StackPanel>
    </StackPanel>
</UserControl>
