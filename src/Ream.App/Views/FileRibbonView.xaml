<UserControl x:Class="Ream.App.Views.FileRibbonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="GroupBand" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="MinHeight" Value="60"/>
        </Style>
        <!-- The auto-save switch: a ribbon tile that stays down while on. -->
        <Style x:Key="ToggleTile" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3,1"/>
        </Style>
        <Style x:Key="DropArrow" TargetType="Path">
            <Setter Property="Data" Value="M0.5,0.5 L3.5,3.5 L6.5,0.5"/>
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
        </Style>
    </UserControl.Resources>

    <!-- The File tab: the ream itself (its file and how it is saved), and Help / About. -->
    <StackPanel Orientation="Horizontal" Margin="12,6,12,2">

        <StackPanel>
            <StackPanel Style="{StaticResource GroupBand}">
                <Button x:Name="NewButton" Style="{StaticResource RibbonTile}" Command="{Binding NewReamCommand}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE8A5;" FontSize="20"/>
                        <TextBlock Text="New" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="OpenButton" Style="{StaticResource RibbonTile}" Command="{Binding OpenReamCommand}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE8E5;" FontSize="20"/>
                        <TextBlock Text="Open" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SaveButton" Style="{StaticResource RibbonTile}" Command="{Binding SaveReamCommand}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE74E;" FontSize="20"/>
                        <TextBlock Text="Save" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SaveAsButton" Style="{StaticResource RibbonTile}" Command="{Binding SaveReamAsCommand}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE792;" FontSize="20"/>
                        <TextBlock Text="Save As" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Ream"/>
        </StackPanel>

        <Rectangle Style="{StaticResource RibbonGroupDivider}"/>

        <!-- Recent: the last few reams opened, saved or created, newest first, like Word's Backstage Open > Recent. -->
        <StackPanel>
            <StackPanel Style="{StaticResource GroupBand}">
                <Button x:Name="RecentButton" Style="{StaticResource RibbonTile}" Click="OnRecentClick">
                    <StackPanel>
                        <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE81C;" FontSize="20"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                            <TextBlock Text="Recent" FontSize="12"/>
                            <Path Style="{StaticResource DropArrow}"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Recent"/>
        </StackPanel>

        <Rectangle Style="{StaticResource RibbonGroupDivider}"/>

        <StackPanel>
            <StackPanel Style="{StaticResource GroupBand}">
                <ToggleButton x:Name="AutoSaveToggle" Style="{StaticResource ToggleTile}"
                              IsChecked="{Binding AutoSave, Mode=OneWay}" Click="OnAutoSaveClick" Command="{Binding ToggleAutoSaveCommand}"
                              ToolTip="Save changes as you make them. Off: changes wait until you save, and the title shows a * while there are unsaved changes.">
                    <StackPanel>
                        <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE895;" FontSize="20"/>
                        <TextBlock Text="Auto-save" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
            <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Saving"/>
        </StackPanel>

        <Rectangle Style="{StaticResource RibbonGroupDivider}"/>

        <StackPanel>
            <StackPanel Style="{StaticResource GroupBand}">
                <Button x:Name="ClearButton" Style="{StaticResource RibbonTile}" Command="{Binding ClearReamCommand}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE74D;" FontSize="20"/>
                        <TextBlock Text="Clear" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Tidy up"/>
        </StackPanel>

        <Rectangle Style="{StaticResource RibbonGroupDivider}"/>

        <StackPanel>
            <StackPanel Style="{StaticResource GroupBand}">
                <Button x:Name="HelpButton" Style="{StaticResource RibbonTile}" Click="OnHelp" ToolTip="Every shortcut, as bound right now">
                    <StackPanel>
                        <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE897;" FontSize="20"/>
                        <TextBlock Text="Help" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="AboutButton" Style="{StaticResource RibbonTile}" Click="OnAbout" ToolTip="Version and where your notes live">
                    <StackPanel>
                        <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE946;" FontSize="20"/>
                        <TextBlock Text="About" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Help"/>
        </StackPanel>
    </StackPanel>
</UserControl>
