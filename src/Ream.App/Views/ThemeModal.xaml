<Window x:Class="Ream.App.Views.ThemeModal" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Theme" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{StaticResource ModalWindowStyle}">
    <!--
        The View tab's single Theme button opens this instead of the three separate Layout / Theme / Opacity ribbon
        groups it used to be. DataContext is the same SettingsViewModel those groups already used, so every binding
        here is exactly the one the ribbon controls had - this is just a different home for them. Gap and the two
        opacities are editable ComboBoxes (Controls.xaml's ComboBox style grew a PART_EditableTextBox for it): pick a
        preset from the dropdown, or type any value in range and press Enter.
    -->
    <StackPanel Margin="20,16,20,18">

        <!-- Layout and Opacity share one section: opacity (Canvas/Notes) on the left, Gap and Center the focused note
             on the right - two rows in each column, so "Center the focused note" sits under Gap the same way Notes
             sits under Canvas, rather than spanning below both. -->
        <TextBlock Text="Layout &amp; Opacity" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <Grid Margin="2,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Canvas" VerticalAlignment="Center" Foreground="{DynamicResource ToolbarMutedBrush}"/>
                    <ComboBox x:Name="CanvasOpacityBox" Grid.Column="1" Width="80" Height="26"
                              IsEditable="True" PreviewKeyDown="OnNumberBoxKeyDown"
                              Text="{Binding OpacityPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"
                              ToolTip="{Binding OpacityHint}"/>
                    <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource ToolbarMutedBrush}"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Notes" VerticalAlignment="Center" Foreground="{DynamicResource ToolbarMutedBrush}"/>
                    <ComboBox x:Name="NoteOpacityBox" Grid.Column="1" Width="80" Height="26"
                              IsEditable="True" PreviewKeyDown="OnNumberBoxKeyDown"
                              Text="{Binding NoteOpacityPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"
                              ToolTip="How solid each note's background is. The text always stays solid."/>
                    <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource ToolbarMutedBrush}"/>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Gap" VerticalAlignment="Center" Foreground="{DynamicResource ToolbarMutedBrush}"/>
                    <ComboBox x:Name="GapBox" Grid.Column="1" Width="80" Height="26"
                              IsEditable="True" PreviewKeyDown="OnNumberBoxKeyDown"
                              Text="{Binding GapPx, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"
                              ToolTip="Space between notes, and around the row (8-60px)"/>
                    <TextBlock Grid.Column="2" Text="px" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource ToolbarMutedBrush}"/>
                </Grid>
                <!-- Height="26" to match the Notes ComboBox it sits under, so the two rows' centers line up even
                     though a CheckBox's own content is shorter than a ComboBox. -->
                <Grid Height="26">
                    <CheckBox x:Name="CenterFocusedCheckBox" Content="Center the focused note" VerticalAlignment="Center"
                              IsChecked="{Binding CenterFocusedColumn, Mode=TwoWay}"
                              ToolTip="Keep the note you're working in centered in the row as you move between notes"/>
                </Grid>
            </StackPanel>
        </Grid>

        <Rectangle Height="1" Fill="{DynamicResource ControlBorderBrush}" Margin="0,16"/>

        <TextBlock Text="Theme" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <ItemsControl x:Name="ThemeList" ItemsSource="{Binding Themes}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- A grid, not one entry per line - Width keeps two per row instead of a single long list with
                         empty space down the right half of the modal; the right margin is the gap between columns. -->
                    <RadioButton GroupName="ThemePicker" Width="164" Margin="2,4,16,4" Checked="OnThemeChecked"
                                 IsChecked="{Binding IsSelected, Mode=OneWay}">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Left" Width="40" Height="20" CornerRadius="4" Margin="0,0,10,0"
                                    BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}"
                                    Background="{Binding Canvas}">
                                <Grid>
                                    <Border Margin="5,4,0,4" Width="18" HorizontalAlignment="Left" CornerRadius="3" Background="{Binding Card}"/>
                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" HorizontalAlignment="Right" Fill="{Binding Accent}"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Margin="0,20,0,0" Padding="18,4"/>
    </StackPanel>
</Window>
