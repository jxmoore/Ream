<Window x:Class="Ream.App.Views.ThemeModal" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Theme" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{StaticResource ModalWindowStyle}">
    <!--
        The View tab's single Theme button opens this instead of the three separate Layout / Theme / Opacity ribbon
        groups it used to be. DataContext is the same SettingsViewModel those groups already used, so every binding
        here is exactly the one the ribbon controls had - this is just a different home for them. Gap and the two
        opacities are editable ComboBoxes (Controls.xaml's ComboBox style grew a PART_EditableTextBox for it): pick a
        preset from the dropdown, or type any value in range and press Enter.
    -->
    <StackPanel Margin="20,16,20,18">

        <TextBlock Text="Layout" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <Grid Margin="2,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Gap" VerticalAlignment="Center" Foreground="{DynamicResource ToolbarMutedBrush}"/>
            <ComboBox x:Name="GapBox" Grid.Column="1" Width="90" Height="26" HorizontalAlignment="Left"
                      IsEditable="True" PreviewKeyDown="OnNumberBoxKeyDown"
                      Text="{Binding GapPx, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"
                      ToolTip="Space between notes, and around the row (8-60px)"/>
        </Grid>
        <CheckBox x:Name="CenterFocusedCheckBox" Content="Center the focused note" Margin="2,10,0,0"
                  IsChecked="{Binding CenterFocusedColumn, Mode=TwoWay}"
                  ToolTip="Keep the note you're working in centered in the row as you move between notes"/>

        <Rectangle Height="1" Fill="{DynamicResource ControlBorderBrush}" Margin="0,16"/>

        <TextBlock Text="Theme" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <ItemsControl x:Name="ThemeList" ItemsSource="{Binding Themes}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton GroupName="ThemePicker" Margin="2,3" Checked="OnThemeChecked"
                                 IsChecked="{Binding IsSelected, Mode=OneWay}">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Left" Width="40" Height="20" CornerRadius="4" Margin="0,0,10,0"
                                    BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}"
                                    Background="{Binding Canvas}">
                                <Grid>
                                    <Border Margin="5,4,0,4" Width="18" HorizontalAlignment="Left" CornerRadius="3" Background="{Binding Card}"/>
                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" HorizontalAlignment="Right" Fill="{Binding Accent}"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Rectangle Height="1" Fill="{DynamicResource ControlBorderBrush}" Margin="0,16"/>

        <TextBlock Text="Opacity" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <Grid Margin="2,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Canvas" VerticalAlignment="Center" Foreground="{DynamicResource ToolbarMutedBrush}"/>
            <ComboBox x:Name="CanvasOpacityBox" Grid.Row="0" Grid.Column="1" Width="90" Height="26" HorizontalAlignment="Left"
                      IsEditable="True" PreviewKeyDown="OnNumberBoxKeyDown"
                      Text="{Binding OpacityPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"
                      ToolTip="{Binding OpacityHint}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Notes" VerticalAlignment="Center" Foreground="{DynamicResource ToolbarMutedBrush}"/>
            <ComboBox x:Name="NoteOpacityBox" Grid.Row="1" Grid.Column="1" Width="90" Height="26" HorizontalAlignment="Left"
                      IsEditable="True" PreviewKeyDown="OnNumberBoxKeyDown"
                      Text="{Binding NoteOpacityPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"
                      ToolTip="How solid each note's background is. The text always stays solid."/>
        </Grid>

        <Button Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Margin="0,20,0,0" Padding="18,4"/>
    </StackPanel>
</Window>
