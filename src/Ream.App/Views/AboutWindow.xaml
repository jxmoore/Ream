<Window x:Class="Ream.App.Views.AboutWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Ream" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <StackPanel Margin="28,24,28,20">
        <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock x:Name="VersionText" Margin="0,2,0,0" Foreground="{DynamicResource MutedTextBrush}"
                   Text="{Binding Version, StringFormat=Version {0}}"/>
        <TextBlock Margin="0,12,0,16" TextWrapping="Wrap"
                   Text="A local-first note-taking app with an infinitely scrollable, niri-style layout: workspaces stacked vertically, notes side by side."/>

        <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="14,10"
                BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Margin" Value="0,4"/>
                        <Setter Property="TextWrapping" Value="Wrap"/>
                    </Style>
                </Grid.Resources>

                <TextBlock Grid.Row="0" Text="Runtime" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,18,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="RuntimeText" Text="{Binding Runtime}"/>
                <TextBlock Grid.Row="1" Text="System" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,18,4"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SystemText" Text="{Binding System}"/>
                <TextBlock Grid.Row="2" Text="Ream file" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,18,4"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="FolderText" Text="{Binding DocumentsFolder}"/>
                <TextBlock Grid.Row="3" Text="Config file" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,18,4"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ConfigText" Text="{Binding ConfigFile}"/>
                <TextBlock Grid.Row="4" Text="Source" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,18,4"/>
                <TextBlock Grid.Row="4" Grid.Column="1">
                    <Hyperlink x:Name="RepositoryLink" NavigateUri="{Binding Repository}" RequestNavigate="OnNavigate"
                               Foreground="{DynamicResource AccentBrush}">
                        <TextBlock Text="{Binding Repository}" Margin="0"/>
                    </Hyperlink>
                </TextBlock>
            </Grid>
        </Border>

        <Button Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right"
                Margin="0,18,0,0" Padding="18,4"/>
    </StackPanel>
</Window>
