<UserControl x:Class="Ream.App.Views.SettingsFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Width="290" Padding="16,14,16,16" CornerRadius="10" BorderThickness="1"
            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.4" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>

            <TextBlock Text="THEME" Margin="0,14,0,6" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedTextBrush}"/>
            <ItemsControl x:Name="ThemeList" ItemsSource="{Binding Themes}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="Row" Margin="0,1" Padding="8,5" HorizontalContentAlignment="Stretch"
                                Background="Transparent" BorderBrush="Transparent"
                                Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" Focusable="False">
                            <DockPanel LastChildFill="True">
                                <TextBlock x:Name="Check" DockPanel.Dock="Right" Text="&#xE73E;" Visibility="Hidden"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                <Border DockPanel.Dock="Left" Width="44" Height="22" CornerRadius="5" Margin="0,0,10,0"
                                        BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}"
                                        Background="{Binding Canvas}">
                                    <Grid>
                                        <Border Margin="6,5,0,5" Width="22" HorizontalAlignment="Left" CornerRadius="3" Background="{Binding Card}"/>
                                        <Ellipse Width="8" Height="8" Margin="0,0,7,0" HorizontalAlignment="Right" Fill="{Binding Accent}"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ControlTextBrush}"/>
                            </DockPanel>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel Margin="0,16,0,4">
                <TextBlock DockPanel.Dock="Right" Text="{Binding OpacityLabel}" MinWidth="36" TextAlignment="Right"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="CANVAS OPACITY" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}"/>
            </DockPanel>
            <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                    IsSnapToTickEnabled="True" TickFrequency="1"
                    Value="{Binding OpacityPercent, Mode=TwoWay}"/>
            <TextBlock Text="{Binding OpacityHint}" Margin="0,2,0,0" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}"/>
        </StackPanel>
    </Border>
</UserControl>
