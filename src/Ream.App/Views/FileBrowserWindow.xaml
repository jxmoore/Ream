<Window x:Class="Ream.App.Views.FileBrowserWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ream.App.Views"
        Width="860" Height="560" MinWidth="660" MinHeight="420" ResizeMode="CanResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{StaticResource ModalWindowStyle}">
    <Window.Resources>
        <!-- A flat icon button for the toolbar. -->
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
        </Style>

        <Style x:Key="CrumbButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <Style x:Key="ListRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ControlCheckedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlaceRow" TargetType="ListBoxItem" BasedOn="{StaticResource ListRow}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Focusable" Value="True"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnPlaceClicked"/>
        </Style>

        <DataTemplate x:Key="EntryTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="84"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource RibbonIcon}" FontSize="16" Width="24" Margin="0,0,6,0" VerticalAlignment="Center"
                               Text="{Binding Converter={x:Static local:EntryColumn.Instance}, ConverterParameter=glyph}"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"
                           Text="{Binding Converter={x:Static local:EntryColumn.Instance}, ConverterParameter=date}"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}"
                           Text="{Binding Converter={x:Static local:EntryColumn.Instance}, ConverterParameter=size}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PlaceTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource RibbonIcon}" FontSize="15" Width="22" Margin="0,0,6,0" VerticalAlignment="Center"
                           Text="{Binding Converter={x:Static local:EntryColumn.Instance}, ConverterParameter=place}"
                           Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CrumbTemplate">
            <StackPanel Orientation="Horizontal">
                <Button Content="{Binding Name}" Tag="{Binding Path}" Style="{StaticResource CrumbButton}" Click="OnCrumbClick"/>
                <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE76C;" FontSize="9" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root" Focusable="True" FocusVisualStyle="{x:Null}" Margin="12,4,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: history, up, the address, refresh, new folder. -->
        <Grid Grid.Row="0" Margin="0,4,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,8,0">
                <Button x:Name="BackButton" Style="{StaticResource ToolButton}" ToolTip="Back (Alt+Left)" Click="OnBack">
                    <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE72B;" FontSize="14"/>
                </Button>
                <Button x:Name="ForwardButton" Style="{StaticResource ToolButton}" ToolTip="Forward (Alt+Right)" Click="OnForward">
                    <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE72A;" FontSize="14"/>
                </Button>
                <Button x:Name="UpButton" Style="{StaticResource ToolButton}" ToolTip="Up one folder (Alt+Up)" Click="OnUp">
                    <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE74A;" FontSize="14"/>
                </Button>
            </StackPanel>

            <Border x:Name="AddressBar" Grid.Column="1" Height="30" CornerRadius="4" BorderThickness="1"
                    Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                    MouseLeftButtonDown="OnAddressBarClick">
                <Grid>
                    <ScrollViewer x:Name="CrumbScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  Focusable="False" Margin="2,0">
                        <ItemsControl x:Name="Crumbs" ItemTemplate="{StaticResource CrumbTemplate}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBox x:Name="AddressBox" Visibility="Collapsed" BorderThickness="0" Background="Transparent"
                             VerticalContentAlignment="Center" Padding="8,0" LostKeyboardFocus="OnAddressLostFocus"
                             PreviewKeyDown="OnAddressKeyDown"/>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Grid.Column="2" Margin="8,0,0,0">
                <Button x:Name="RefreshButton" Style="{StaticResource ToolButton}" ToolTip="Refresh (F5)" Click="OnRefresh">
                    <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE72C;" FontSize="14"/>
                </Button>
                <Button x:Name="NewFolderButton" Style="{StaticResource ToolButton}" ToolTip="New folder (Ctrl+Shift+N)" Click="OnNewFolderClick">
                    <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE8F4;" FontSize="14"/>
                </Button>
                <Popup x:Name="NewFolderPopup" PlacementTarget="{Binding ElementName=NewFolderButton}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" Opened="OnNewFolderOpened">
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4,8,8">
                        <StackPanel Width="230">
                            <TextBlock Text="New folder" Margin="0,0,0,6" Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBox x:Name="NewFolderBox" PreviewKeyDown="OnNewFolderKeyDown"/>
                            <TextBlock x:Name="NewFolderError" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Grid>

        <!-- Places on the left, the folder's contents on the right. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1" CornerRadius="4">
                <ListBox x:Name="PlacesList" IsSynchronizedWithCurrentItem="False" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                         ItemContainerStyle="{StaticResource PlaceRow}" ItemTemplate="{StaticResource PlaceTemplate}"
                         SelectionChanged="OnPlaceSelected" Margin="0,4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="11" Margin="10,8,0,2"
                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="6,4,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="84"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="NameHeader" Grid.Column="0" Style="{StaticResource HeaderButton}" Click="OnSortName">
                            <StackPanel Orientation="Horizontal" Margin="30,0,0,0">
                                <TextBlock Text="Name"/>
                                <TextBlock x:Name="NameArrow" Style="{StaticResource RibbonIcon}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="DateHeader" Grid.Column="1" Style="{StaticResource HeaderButton}" Click="OnSortDate">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Date modified"/>
                                <TextBlock x:Name="DateArrow" Style="{StaticResource RibbonIcon}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="2" Text="Size" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                                 ItemContainerStyle="{StaticResource ListRow}" ItemTemplate="{StaticResource EntryTemplate}"
                                 SelectionMode="Single" Margin="4,2,4,4" SelectionChanged="OnEntrySelected"
                                 PreviewKeyDown="OnFileListKeyDown"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        <TextBlock x:Name="ListingErrorText" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="360" TextAlignment="Center" Foreground="{DynamicResource ErrorBrush}" Visibility="Collapsed"
                                   IsHitTestVisible="False"/>
                        <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- The name, the filter, and the buttons. -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="File name:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="FileNameBox" Grid.Row="0" Grid.Column="1" Padding="6,4"
                     TextChanged="OnFileNameChanged"/>
            <ComboBox x:Name="FilterBox" Grid.Row="0" Grid.Column="2" Width="190" Margin="10,0,0,0" SelectedIndex="0"
                      SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="Ream files (*.ream)"/>
                <ComboBoxItem Content="All files (*.*)"/>
            </ComboBox>

            <TextBlock x:Name="ErrorText" Grid.Row="1" Grid.Column="1" Margin="0,8,10,0" MinHeight="20" TextWrapping="Wrap"
                       VerticalAlignment="Center" Foreground="{DynamicResource ErrorBrush}"/>
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="AcceptButton" MinWidth="88" Padding="16,5" IsDefault="True" Click="OnAccept"
                        BorderThickness="2" BorderBrush="{DynamicResource FocusBorderBrush}"/>
                <Button x:Name="CancelButton" MinWidth="88" Padding="16,5" Margin="8,0,0,0" Content="Cancel" IsCancel="True" Click="OnCancel"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
