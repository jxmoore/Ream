<UserControl x:Class="Ream.App.Views.NoteColumnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown">
    <Border CornerRadius="10" BorderThickness="2" Background="{DynamicResource CardBrush}" ClipToBounds="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFocused}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{Binding AccentColor}"/>

            <DockPanel Grid.Row="1" Margin="16,12,16,4" LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text="{Binding WidthLabel}" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextBrush}"/>
            </DockPanel>

            <RichTextBox x:Name="Editor" Grid.Row="2"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextBrush}"
                         CaretBrush="{DynamicResource TextBrush}"
                         SelectionBrush="{DynamicResource AccentBrush}"
                         FontFamily="Segoe UI" FontSize="14"
                         Padding="12,4,12,12"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         AcceptsTab="True"
                         SpellCheck.IsEnabled="True">
                <RichTextBox.Resources>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0,0,0,6"/>
                    </Style>
                </RichTextBox.Resources>
            </RichTextBox>

            <Thumb x:Name="ResizeHandle" Grid.RowSpan="3" HorizontalAlignment="Right" Width="10"
                   Cursor="SizeWE" ToolTip="Drag to resize"
                   DragStarted="OnResizeStarted" DragDelta="OnResizeDelta" DragCompleted="OnResizeCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Border x:Name="Grip" Width="3" CornerRadius="2" Background="Transparent" HorizontalAlignment="Center" Margin="0,24"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</UserControl>
