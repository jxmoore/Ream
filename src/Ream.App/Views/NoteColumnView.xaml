<UserControl x:Class="Ream.App.Views.NoteColumnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown">
    <Border CornerRadius="10" BorderThickness="2" Background="{StaticResource CardBrush}" ClipToBounds="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFocused}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{Binding AccentColor}"/>

            <DockPanel Grid.Row="1" Margin="16,12,16,4" LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text="{Binding WidthLabel}" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextBrush}"/>
            </DockPanel>

            <RichTextBox x:Name="Editor" Grid.Row="2"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource TextBrush}"
                         CaretBrush="{StaticResource TextBrush}"
                         SelectionBrush="{StaticResource AccentBrush}"
                         FontFamily="Segoe UI" FontSize="14"
                         Padding="12,4,12,12"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         AcceptsTab="True"
                         SpellCheck.IsEnabled="True">
                <RichTextBox.Resources>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0,0,0,6"/>
                    </Style>
                </RichTextBox.Resources>
            </RichTextBox>
        </Grid>
    </Border>
</UserControl>
