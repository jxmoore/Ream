<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Canvas and cards -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#15151a"/>
    <SolidColorBrush x:Key="CardBrush" Color="#23232b"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#33333d"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#7c9cff"/>
    <SolidColorBrush x:Key="TextBrush" Color="#e8e8ee"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#8a8a99"/>

    <!-- Toolbar and workspace chips -->
    <SolidColorBrush x:Key="ToolbarBrush" Color="#1d1d24"/>
    <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#33333d"/>
    <SolidColorBrush x:Key="ToolbarMutedBrush" Color="#9a9aa8"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#41414f"/>
    <SolidColorBrush x:Key="ChipCurrentBrush" Color="#3e63dd"/>
    <SolidColorBrush x:Key="ChipCurrentTextBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#ff7b7b"/>

    <!-- Buttons, drop-downs, text boxes -->
    <SolidColorBrush x:Key="ControlBrush" Color="#2b2b35"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#363642"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#41414f"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#3d3d4a"/>
    <SolidColorBrush x:Key="ControlCheckedBrush" Color="#34457a"/>
    <SolidColorBrush x:Key="ControlTextBrush" Color="#e8e8ee"/>
    <SolidColorBrush x:Key="InputBrush" Color="#15151a"/>

    <!-- Scrollbars -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4a4a58"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#62627a"/>
</ResourceDictionary>
