<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Canvas and cards -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#e9e9ee"/>
    <SolidColorBrush x:Key="CardBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#d5d5de"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#3e63dd"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1a1a22"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#6b6b78"/>

    <!-- Toolbar and workspace chips -->
    <SolidColorBrush x:Key="ToolbarBrush" Color="#f6f6f9"/>
    <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#d5d5de"/>
    <SolidColorBrush x:Key="ToolbarMutedBrush" Color="#5c5c6a"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#c4c4cc"/>
    <SolidColorBrush x:Key="ChipCurrentBrush" Color="#3e63dd"/>
    <SolidColorBrush x:Key="ChipCurrentTextBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#c62828"/>

    <!-- Buttons, drop-downs, text boxes -->
    <SolidColorBrush x:Key="ControlBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#eeeef4"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#e0e0ea"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#c4c4cc"/>
    <SolidColorBrush x:Key="ControlCheckedBrush" Color="#cfe0ff"/>
    <SolidColorBrush x:Key="ControlTextBrush" Color="#1a1a22"/>
    <SolidColorBrush x:Key="InputBrush" Color="#ffffff"/>

    <!-- Scrollbars -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#c0c0cc"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#a0a0b2"/>
</ResourceDictionary>
