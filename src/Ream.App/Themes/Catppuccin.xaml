<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Canvas and cards -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#11111b"/>
    <SolidColorBrush x:Key="CardBrush" Color="#1e1e2e"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#313244"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#cba6f7"/>
    <SolidColorBrush x:Key="TextBrush" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#a6adc8"/>

    <!-- Toolbar and workspace chips -->
    <SolidColorBrush x:Key="ToolbarBrush" Color="#181825"/>
    <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#313244"/>
    <SolidColorBrush x:Key="ToolbarMutedBrush" Color="#a6adc8"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#45475a"/>
    <SolidColorBrush x:Key="ChipCurrentBrush" Color="#cba6f7"/>
    <SolidColorBrush x:Key="ChipCurrentTextBrush" Color="#11111b"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#f38ba8"/>

    <!-- Buttons, drop-downs, text boxes -->
    <SolidColorBrush x:Key="ControlBrush" Color="#313244"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#3b3d52"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#45475a"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#45475a"/>
    <SolidColorBrush x:Key="ControlCheckedBrush" Color="#5b4f85"/>
    <SolidColorBrush x:Key="ControlTextBrush" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="InputBrush" Color="#181825"/>

    <!-- Scrollbars -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#45475a"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#585b70"/>
</ResourceDictionary>
