<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Canvas and cards -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#191a21"/>
    <SolidColorBrush x:Key="CardBrush" Color="#282a36"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#44475a"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#bd93f9"/>
    <SolidColorBrush x:Key="TextBrush" Color="#f8f8f2"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9aa3c9"/>

    <!-- Toolbar and workspace chips -->
    <SolidColorBrush x:Key="ToolbarBrush" Color="#21222c"/>
    <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#343746"/>
    <SolidColorBrush x:Key="ToolbarMutedBrush" Color="#a5adcf"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#44475a"/>
    <SolidColorBrush x:Key="ChipCurrentBrush" Color="#7c5cc4"/>
    <SolidColorBrush x:Key="ChipCurrentTextBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#ff6e6e"/>

    <!-- Buttons, drop-downs, text boxes -->
    <SolidColorBrush x:Key="ControlBrush" Color="#343746"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#3e4155"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#44475a"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#4a4d63"/>
    <SolidColorBrush x:Key="ControlCheckedBrush" Color="#5b4b8a"/>
    <SolidColorBrush x:Key="ControlTextBrush" Color="#f8f8f2"/>
    <SolidColorBrush x:Key="InputBrush" Color="#21222c"/>

    <!-- Scrollbars -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4d5170"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#6272a4"/>
</ResourceDictionary>
