<Window x:Class="Ream.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Ream.App.Controls"
        xmlns:views="clr-namespace:Ream.App.Views"
        Title="{Binding WindowTitle}" Height="720" Width="1200" MinWidth="480" MinHeight="320"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
        Background="Transparent" Foreground="{DynamicResource TextBrush}">
    <!--
        Ream draws its own window frame, so the title bar is exactly the theme's canvas color and the whole window
        can be see-through. Each region below paints its own background exactly once (the window itself is
        transparent) so translucent brushes don't stack on top of each other.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- The File button: the one accent-colored control, like Word's blue File tab. -->
        <Style x:Key="FileButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ChipCurrentTextBrush}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="4" Padding="16,3" Background="{DynamicResource ChipCurrentBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimize / maximize / close. Close goes red on hover like every Windows app. -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent">
                            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlPressedBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="close"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="#e81123"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowBorder" BorderThickness="1" BorderBrush="{DynamicResource ToolbarBorderBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--
                Title bar: "Ream - Workspace" at the left (double-click it to rename the workspace), minimize / maximize /
                close at the right. In app fullscreen it is hidden, except while a rename is in progress.
            -->
            <Grid x:Name="TitleBar" Grid.Row="0" Height="32" Background="{DynamicResource CanvasBrush}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <Trigger Property="Tag" Value="fullscreen">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding CurrentWorkspace.IsRenaming}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="12,0,8,0" HorizontalAlignment="Left">
                    <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontSize="12"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               ToolTip="Double-click to rename this workspace"
                               shell:WindowChrome.IsHitTestVisibleInChrome="True"
                               MouseLeftButtonDown="OnTitleMouseDown">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentWorkspace.IsRenaming}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel x:Name="TitleEdit" Orientation="Horizontal" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentWorkspace.IsRenaming}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Ream - " VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                        <TextBox x:Name="TitleBox" MinWidth="200" MaxLength="40" FontSize="12" Padding="4,2"
                                 Text="{Binding CurrentWorkspace.EditName, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="OnTitleKeyDown" LostKeyboardFocus="OnTitleLostFocus"
                                 IsVisibleChanged="OnTitleBoxVisibleChanged"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;"
                            ToolTip="Minimize" Click="OnMinimize"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;"
                            ToolTip="Maximize" Click="OnMaximize"/>
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE8BB;"
                            Tag="close" ToolTip="Close" Click="OnClose"/>
                </StackPanel>
            </Grid>

            <!-- Tab row: File, Home, and (at the right) the settings. -->
            <DockPanel x:Name="TabRow" Grid.Row="1" Background="{DynamicResource CanvasBrush}" Height="36" LastChildFill="False">
                <TextBlock x:Name="ConfigProblem" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,12,0"
                           FontSize="12" Text="Config problem (hover)" ToolTip="{Binding ConfigError}"
                           Foreground="{DynamicResource ErrorBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConfigError}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button x:Name="SettingsButton" DockPanel.Dock="Right" Margin="0,0,10,0" Width="30" Height="26" Padding="0"
                        Focusable="False" ToolTip="Settings" Click="OnSettingsClick"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Content="&#xE713;"/>
                <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom"
                       HorizontalOffset="-272" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                       Closed="OnSettingsClosed">
                    <views:SettingsFlyout x:Name="SettingsPanel" Margin="0,4,12,12"/>
                </Popup>

                <Button x:Name="FileButton" DockPanel.Dock="Left" Margin="8,0,6,0" Height="24" Content="File"
                        Style="{StaticResource FileButtonStyle}" Click="OnFileClick" ToolTip="File">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="FileMenu" Closed="OnFileMenuClosed" Opened="OnFileMenuOpened">
                            <MenuItem x:Name="OpenMenuItem" Header="Open Ream…" IsEnabled="False"
                                      ToolTipService.ShowOnDisabled="True" ToolTip="Coming soon"/>
                            <MenuItem x:Name="WorkspacesMenuItem" Header="Workspaces"/>
                            <Separator/>
                            <MenuItem x:Name="HelpMenuItem" Header="Help" Click="OnHelpClick"/>
                            <MenuItem x:Name="AboutMenuItem" Header="About" Click="OnAboutClick"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- The only tab for now; it sits on the ribbon below like Word's active tab. -->
                <Border x:Name="HomeTab" DockPanel.Dock="Left" VerticalAlignment="Bottom" Height="30" Padding="16,0"
                        CornerRadius="6,6,0,0" Background="{DynamicResource RibbonBrush}">
                    <Grid>
                        <TextBlock Text="Home" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                        <Border Height="2" VerticalAlignment="Bottom" Margin="0,0,0,1" Background="{DynamicResource AccentBrush}"/>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- The ribbon panel under the tab. -->
            <Border x:Name="RibbonPanel" Grid.Row="2" Background="{DynamicResource RibbonBrush}"
                    BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="0,0,0,1">
                <views:RibbonView x:Name="Ribbon" HorizontalAlignment="Left"/>
            </Border>

            <Grid x:Name="CanvasArea" Grid.Row="3" Background="{DynamicResource CanvasBrush}">
                <ItemsControl ItemsSource="{Binding Workspaces}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:WorkspaceStripPanel
                                CurrentIndex="{Binding CurrentIndex}"
                                SuppressAnimation="{Binding SuppressAnimation}"
                                Config="{Binding Config}"
                                SwitchCompletedCommand="{Binding PruneEmptyWorkspacesCommand}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:WorkspaceView/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Border>
</Window>
