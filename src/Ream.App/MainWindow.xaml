<Window x:Class="Ream.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Ream.App.Controls"
        xmlns:views="clr-namespace:Ream.App.Views"
        Title="Ream" Height="720" Width="1200"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="{StaticResource ToolbarBrush}">
            <TextBlock DockPanel.Dock="Right" Text="{Binding IndicatorText}" VerticalAlignment="Center"
                       Margin="12,0,16,0" FontSize="12" Foreground="{StaticResource ToolbarMutedBrush}"/>
            <views:EditorToolbar/>
        </DockPanel>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Workspaces}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:WorkspaceStripPanel
                        CurrentIndex="{Binding CurrentIndex}"
                        SuppressAnimation="{Binding SuppressAnimation}"
                        Config="{Binding Config}"
                        SwitchCompletedCommand="{Binding PruneEmptyWorkspacesCommand}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <views:WorkspaceView/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
