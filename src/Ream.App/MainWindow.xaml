<Window x:Class="Ream.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Ream.App.Controls"
        xmlns:views="clr-namespace:Ream.App.Views"
        Title="{Binding WindowTitle}" Height="720" Width="1200" MinWidth="480" MinHeight="320"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
        Background="Transparent" Foreground="{DynamicResource TextBrush}">
    <!--
        Ream draws its own window frame, so the title bar is exactly the theme's canvas color and the whole window
        can be see-through. Each region below paints its own background exactly once (the window itself is
        transparent) so translucent brushes don't stack on top of each other.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- A ribbon tab (File, Home, View): the selected one sits on the panel below it, like Word's. -->
        <Style x:Key="RibbonTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Plate" CornerRadius="6,6,0,0" Background="Transparent">
                            <Border x:Name="Root" Padding="16,0" CornerRadius="6,6,0,0" Background="Transparent">
                                <Grid>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                            Background="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource RibbonBrush}"/>
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border x:Name="WindowBorder" BorderThickness="1" BorderBrush="{DynamicResource WindowBorderBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--
                Title bar: just "Ream" at the left (a ream's own name will join it one day), minimize / maximize / close
                at the right. In app fullscreen it is hidden. The workspace's name lives in the bottom-right corner.
            -->
            <Grid x:Name="TitleBar" Grid.Row="0" Height="32">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Background" Value="{DynamicResource CanvasBrush}"/>
                        <Style.Triggers>
                            <!-- Reaching for the title or the window buttons puts a backdrop behind them (matters when the canvas is clear). -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ChromeHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="fullscreen">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleText" Grid.Column="0" Margin="12,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                           FontSize="12" Foreground="{DynamicResource TextBrush}"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;"
                            ToolTip="Minimize" Click="OnMinimize"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;"
                            ToolTip="Maximize" Click="OnMaximize"/>
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE8BB;"
                            Tag="close" ToolTip="Close" Click="OnClose"/>
                </StackPanel>
            </Grid>

            <!-- Tab row: File | Home | View. Each tab swaps the ribbon panel below it. -->
            <DockPanel x:Name="TabRow" Grid.Row="1" Height="36" LastChildFill="False"
                       MouseEnter="OnRibbonAreaMouse" MouseLeave="OnRibbonAreaMouse">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Background" Value="{DynamicResource CanvasBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ChromeHoverBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <TextBlock x:Name="ConfigProblem" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,12,0"
                           FontSize="12" Text="Config problem (hover)" ToolTip="{Binding ConfigError}"
                           Foreground="{DynamicResource ErrorBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConfigError}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="8,0,0,0">
                    <RadioButton x:Name="FileTab" GroupName="RibbonTabs" Content="File" Tag="File"
                                 Style="{StaticResource RibbonTabStyle}" Click="OnTabClick" ToolTip="Ream, workspaces, help"/>
                    <RadioButton x:Name="HomeTab" GroupName="RibbonTabs" Content="Home" Tag="Home"
                                 Style="{StaticResource RibbonTabStyle}" Click="OnTabClick" ToolTip="Formatting"/>
                    <RadioButton x:Name="ViewTab" GroupName="RibbonTabs" Content="View" Tag="View"
                                 Style="{StaticResource RibbonTabStyle}" Click="OnTabClick" ToolTip="Theme and opacity"/>
                </StackPanel>
            </DockPanel>

            <!--
                The ribbon panel under the tabs: whichever tab is selected. It scrolls sideways when the window is narrow.
                With ribbon.autoHide (the default) its height grows from 0 when it is summoned and back to 0 when it is put
                away, so it pushes the notes down instead of covering them; the pin button inside it keeps it open.
            -->
            <Border x:Name="RibbonPanel" Grid.Row="2" Height="90" ClipToBounds="True"
                    BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="0,0,0,1"
                    MouseEnter="OnRibbonAreaMouse" MouseLeave="OnRibbonAreaMouse">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource RibbonBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RibbonHoverBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <!-- No scrollbar: when there is more to the right (or left) a small chevron appears at that edge, and the wheel scrolls too. -->
                        <ScrollViewer x:Name="RibbonScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="OnRibbonWheel" ScrollChanged="OnRibbonScrollChanged" Focusable="False">
                            <Grid>
                                <views:FileRibbonView x:Name="FileRibbon" HorizontalAlignment="Left" Visibility="Collapsed"/>
                                <views:RibbonView x:Name="Ribbon" HorizontalAlignment="Left"/>
                                <views:ViewRibbonView x:Name="ViewRibbon" HorizontalAlignment="Left" Visibility="Collapsed"/>
                            </Grid>
                        </ScrollViewer>
                        <Button x:Name="RibbonScrollLeft" Tag="-1" Click="OnRibbonChevron" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="3,0,0,10" Width="22" Height="44" Padding="0" MinWidth="0" Focusable="False" Visibility="Collapsed"
                                ToolTip="More to the left" Content="‹" FontSize="20"/>
                        <Button x:Name="RibbonScrollRight" Tag="1" Click="OnRibbonChevron" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,3,10" Width="22" Height="44" Padding="0" MinWidth="0" Focusable="False" Visibility="Collapsed"
                                ToolTip="More to the right" Content="›" FontSize="20"/>
                    </Grid>

                    <!-- Keeps the ribbon open until clicked again. Only meaningful with auto-hide. -->
                    <ToggleButton x:Name="PinButton" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="4,6,8,0"
                                  Width="28" Height="26" Padding="0" MinWidth="0" Focusable="False" Click="OnPinClick"
                                  ToolTip="Keep the ribbon open" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Content="&#xE718;"/>
                </Grid>
            </Border>

            <Grid x:Name="CanvasArea" Grid.Row="3" Background="{DynamicResource CanvasBrush}">
                <ItemsControl ItemsSource="{Binding Workspaces}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:WorkspaceStripPanel
                                CurrentIndex="{Binding CurrentIndex}"
                                SuppressAnimation="{Binding SuppressAnimation}"
                                Config="{Binding Config}"
                                SwitchCompletedCommand="{Binding PruneEmptyWorkspacesCommand}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:WorkspaceView/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                    The current workspace's name, bottom right, in the gap under the notes. Double-click it (or Shift+F2)
                    to rename in place. Plain text with no background of its own, so at 0% it floats over the desktop;
                    it gets a backdrop while the pointer is on it.
                -->
                <Grid x:Name="WorkspaceLabelHost" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,6">
                    <TextBlock x:Name="WorkspaceLabel" Padding="6,2" FontSize="12" TextTrimming="CharacterEllipsis"
                               MaxWidth="320"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="{Binding WorkspaceLabel}"
                               ToolTip="Double-click to rename this workspace"
                               MouseLeftButtonDown="OnWorkspaceLabelMouseDown">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ChromeHoverBrush}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding CurrentWorkspace.IsRenaming}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="WorkspaceNameBox" MinWidth="180" MaxLength="40" FontSize="12" Padding="4,2"
                             Text="{Binding CurrentWorkspace.EditName, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="OnWorkspaceNameKeyDown" LostKeyboardFocus="OnWorkspaceNameLostFocus"
                             IsVisibleChanged="OnWorkspaceNameVisibleChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentWorkspace.IsRenaming}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
