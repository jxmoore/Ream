<Application x:Class="Ream.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#15151a"/>
        <SolidColorBrush x:Key="CardBrush" Color="#23232b"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#33333d"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7c9cff"/>
        <SolidColorBrush x:Key="TextBrush" Color="#e8e8ee"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8a8a99"/>
        <SolidColorBrush x:Key="ToolbarBrush" Color="#ececf1"/>
        <SolidColorBrush x:Key="ToolbarMutedBrush" Color="#6b6b78"/>
    </Application.Resources>
</Application>
