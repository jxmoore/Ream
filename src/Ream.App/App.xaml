<Application x:Class="Ream.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ThemeService replaces these whenever the theme or the settings behind them change. -->
            <SolidColorBrush x:Key="CanvasBrush" Color="#15151a"/>
            <SolidColorBrush x:Key="RibbonBrush" Color="#1d1d24"/>
            <SolidColorBrush x:Key="FocusBorderBrush" Color="#7c9cff"/>
            <SolidColorBrush x:Key="WindowBorderBrush" Color="#33333d"/>
            <SolidColorBrush x:Key="NoteBrush" Color="#23232b"/>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the active palette; ThemeService swaps it for the chosen theme's file. -->
                <ResourceDictionary Source="Themes/Dark.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
